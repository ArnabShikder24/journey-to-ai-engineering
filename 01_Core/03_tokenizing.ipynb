      ]
     },
     "execution_count": 10,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "text = \"Hi my name is Arnab\"\n",
    "\n",
    "tokens = encoding.encode(text)\n",
    "\n",
    "tokens"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "1201ee56",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "12194 = Hi\n",
      "922 =  my\n",
      "1308 =  name\n",
      "382 =  is\n",
      "49002 =  Arn\n",
      "378 = ab\n"
     ]
    }
   ],
   "source": [
    "for token_id in tokens:\n",
    "  token_str = encoding.decode([token_id])\n",
    "  print(f\"{token_id} = {token_str}\")"
   ]
  }
